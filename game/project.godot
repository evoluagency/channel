; Valdora (por EVOLU Channel) — nome interno legado preservado para manter user://
config_version=5

[application]
config/name="Valdora"
run/main_scene="res://scenes/Main.tscn"
config/icon="res://assets/branding/valdora_192.png"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.027, 0.106, 0.192, 1)
config/description="Valdora: RPG 3D medieval independente. Desenvolvido por EVOLU Channel."
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]
ValdoraPacks="*res://scripts/updates/boot_loader.gd"
ValdoraUpdater="*res://scripts/updates/update_manager.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/handheld/orientation=0

[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

[physics]
3d/default_gravity=23.0