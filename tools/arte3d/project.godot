; Projeto só de arte: gera as folhas das construções. Não faz parte do jogo.
config_version=5

[application]
config/name="MUNDO arte3d"
run/main_scene="res://render.tscn"
run/main_scene.mobile="res://cidade.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

window/handheld/orientation=1
window/size/viewport_width=900
window/size/viewport_height=900

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=3
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=4
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=1
